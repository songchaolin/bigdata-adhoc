<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.gitee.songchaolin.adhoc.dao.mapper.AdhocResultSummaryMapper">

    <resultMap id="BaseResultMap" type="io.gitee.songchaolin.adhoc.dao.entity.AdhocResultSummary">
        <id column="query_id" property="queryId"/>
        <result column="result_rows" property="resultRows"/>
        <result column="result_bytes" property="resultBytes"/>
        <result column="persistent_path" property="persistentPath"/>
        <result column="storage_type" property="storageType"/>
        <result column="result_status" property="resultStatus"/>
        <result column="oss_upload_status" property="ossUploadStatus"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        query_id, result_rows, result_bytes, persistent_path, storage_type, result_status, oss_upload_status, create_time
    </sql>

    <!-- 本地 TTL 2h：LOCAL_PERSISTENT + local_expire_time 过期 -> PERSISTENT_ONLY -->
    <update id="updateExpiredLocalToPersistentOnly">
        UPDATE adhoc_result_summary SET storage_type='PERSISTENT_ONLY'
        WHERE storage_type='LOCAL_PERSISTENT' AND local_expire_time &lt; NOW()
    </update>

    <!-- HDFS TTL 30d：查超过 N 天的 result_summary（待删 HDFS 文件 + 行） -->
    <select id="selectOldResultSummaries" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM adhoc_result_summary
        WHERE create_time &lt; NOW() - INTERVAL #{days} DAY
    </select>

</mapper>