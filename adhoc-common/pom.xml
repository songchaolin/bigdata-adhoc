<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.gitee.songchaolin</groupId>
        <artifactId>bigdata-adhoc</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>adhoc-common</artifactId>
    <name>adhoc-common</name>
    <description>枚举（SqlType/Status/Stage/fail_*）/ 异常（AdhocException + ADHOC_* 错误码）/ 工具类 / 公共 DTO 契约（request/response/VO + PageRequest 基类）</description>

    <dependencies>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>cn.hutool</groupId><artifactId>hutool-all</artifactId></dependency>
        <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
        <!-- Bean Validation（@Valid/@NotBlank/@Range）：分页/请求 DTO 校验 -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <!-- Swagger 注解（@ApiModel/@ApiModelProperty），版本由 BOM 锁定 -->
        <dependency><groupId>io.swagger</groupId><artifactId>swagger-annotations</artifactId></dependency>
        <!-- Apollo 配置变更监听（ApolloConfigChangeLogger，@ConditionalOnClass 守护；optional 非传递，仅 server/executor 有 apollo-client 时生效，sdk/parser 不引入） -->
        <dependency><groupId>com.ctrip.framework.apollo</groupId><artifactId>apollo-client</artifactId><optional>true</optional></dependency>
        <!-- 单测（JUnit 5，版本由 Boot BOM 托管）：Result 线上格式回归等纯逻辑测试 -->
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>
</project>
